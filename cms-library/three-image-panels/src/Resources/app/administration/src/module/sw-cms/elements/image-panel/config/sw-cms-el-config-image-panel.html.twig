<div class="sw-cms-el-config-image-panel">
    <sw-media-field :value="element.config.backgroundMedia.value" :label="$t('vierpunkt-theme.cms.backgroundCard.backgroundMedia')" file-accept="image/*" @update:value="updateField('backgroundMedia', $event)" />
    <sw-text-field :value="element.config.headline.value" :label="$t('vierpunkt-theme.cms.contentCard.headline')" @update:value="updateField('headline', $event)" />
    <sw-textarea-field :value="element.config.text.value" :label="$t('vierpunkt-theme.cms.imagePanel.subheadline')" @update:value="updateField('text', $event)" />
    <sw-text-field :value="element.config.buttonText.value" :label="$t('vierpunkt-theme.cms.contentCard.buttonText')" @update:value="updateField('buttonText', $event)" />
    <sw-text-field :value="element.config.buttonUrl.value" :label="$t('vierpunkt-theme.cms.contentCard.buttonUrl')" @update:value="updateField('buttonUrl', $event)" />
</div>
