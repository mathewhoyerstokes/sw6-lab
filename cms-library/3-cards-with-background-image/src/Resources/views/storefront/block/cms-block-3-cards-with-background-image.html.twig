{% block cms_block_three_cards_with_background_image %}
    {% set columns = 3 %}
    {% for index in 1..3 %}
        {% set element = block.slots.getSlot('card-' ~ index) %}
        {% if element %}
            <div class="col-12 col-lg-4 d-flex" data-cms-element-id="{{ element.id }}">
                {% sw_include '@Storefront/storefront/element/cms-element-' ~ element.type ~ '.html.twig' with {
                    element: element
                } %}
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
