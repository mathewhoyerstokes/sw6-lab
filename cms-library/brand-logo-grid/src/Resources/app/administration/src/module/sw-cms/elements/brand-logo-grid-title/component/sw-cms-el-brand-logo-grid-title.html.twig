{% block sw_cms_element_brand_logo_grid_title %}
    <input
        class="sw-cms-el-brand-logo-grid-title"
        type="text"
        :value="element.config.headline.value"
        :placeholder="$t('vierpunkt-theme.cms.brandLogoGrid.headline')"
        @input="onHeadlineChange($event.target.value)"
        @click.stop
    >
{% endblock %}
