{% block sw_cms_el_content_card %}
    <div class="sw-cms-el-content-card" :style="{ backgroundColor: element.config.backgroundColor.value }">

        <img
            v-if="imageUrl"
            class="sw-cms-el-content-card__image"
            :src="imageUrl"
            :alt="element.config.imageAlt.value"
        >

        <h4>{{ element.config.headline.value || $t('vierpunkt-theme.cms.contentCard.headline') }}</h4>
        <p>{{ element.config.text.value || $t('vierpunkt-theme.cms.contentCard.text') }}</p>
        <span class="sw-cms-el-content-card__button">
            {{ element.config.buttonText.value || $t('vierpunkt-theme.cms.contentCard.buttonText') }}
        </span>
    </div>
{% endblock %}
