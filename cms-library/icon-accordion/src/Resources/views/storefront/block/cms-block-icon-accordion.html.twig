{% block cms_block_icon_accordion %}
    {% set element = block.slots.getSlot('content') %}
    {% if element %}
        <div class="col-12" data-cms-element-id="{{ element.id }}">
            {% sw_include '@Storefront/storefront/element/cms-element-icon-accordion.html.twig' %}
        </div>
    {% endif %}
{% endblock %}
