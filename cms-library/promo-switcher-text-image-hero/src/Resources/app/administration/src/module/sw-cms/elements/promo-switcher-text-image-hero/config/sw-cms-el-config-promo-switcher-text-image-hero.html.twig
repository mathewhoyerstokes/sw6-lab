{% block sw_cms_el_config_promo_switcher_text_image_hero %}
    <div class="sw-cms-el-config-promo-switcher-text-image-hero">
        <sw-switch-field
            v-model:value="element.config.imageOnRight.value"
            :label="$t('vierpunkt-theme.cms.promoSwitcherTextImageHero.imageOnRight')"
            :help-text="$t('vierpunkt-theme.cms.promoSwitcherTextImageHero.imageOnRightHelp')"
            @update:value="onElementUpdate"
        />
        <sw-text-field
            v-model:value="element.config.headline.value"
            :label="$t('vierpunkt-theme.cms.promoSwitcherTextImageHero.headline')"
            @update:value="onElementUpdate"
        />
        <sw-textarea-field
            v-model:value="element.config.text.value"
            :label="$t('vierpunkt-theme.cms.promoSwitcherTextImageHero.text')"
            @update:value="onElementUpdate"
        />
        <sw-text-field
            v-model:value="element.config.buttonText.value"
            :label="$t('vierpunkt-theme.cms.promoSwitcherTextImageHero.buttonText')"
            @update:value="onElementUpdate"
        />
        <sw-text-field
            v-model:value="element.config.buttonUrl.value"
            :label="$t('vierpunkt-theme.cms.promoSwitcherTextImageHero.buttonUrl')"
            @update:value="onElementUpdate"
        />
        <sw-text-field
            v-model:value="element.config.buttonTwoText.value"
            :label="$t('vierpunkt-theme.cms.promoSwitcherTextImageHero.buttonTwoText')"
            @update:value="onElementUpdate"
        />
        <sw-text-field
            v-model:value="element.config.buttonTwoUrl.value"
            :label="$t('vierpunkt-theme.cms.promoSwitcherTextImageHero.buttonTwoUrl')"
            @update:value="onElementUpdate"
        />
    </div>
{% endblock %}
