{% block cms_block_four_cards %}
    {% set columns = 4 %}
    {% for index in 1..4 %}
        {% set element = block.slots.getSlot('card-' ~ index) %}
        {% if element %}
            <div class="col-12 col-lg-3 d-flex" data-cms-element-id="{{ element.id }}">
                {% sw_include '@Storefront/storefront/element/cms-element-' ~ element.type ~ '.html.twig' with {
                    element: element
                } %}
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
