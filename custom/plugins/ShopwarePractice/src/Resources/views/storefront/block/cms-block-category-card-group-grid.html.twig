{% block cms_block_category_card_group_grid %}
    {% set columns = 4 %}
    {% for index in 1..4 %}
        {% set element = block.slots.getSlot('category-' ~ index) %}
        {% if element and (element.type != 'category-card' or element.data.category) %}
            <div class="col-12 col-md-6 col-lg-3 d-flex" data-cms-element-id="{{ element.id }}">
                {% sw_include '@Storefront/storefront/element/cms-element-' ~ element.type ~ '.html.twig' with {
                    element: element
                } %}
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
