{% block sw_cms_el_promo_switcher_text_image_hero %}
    <div class="sw-cms-el-promo-switcher-text-image-hero">
        <h3>{{ element.config.headline.value || $t('vierpunkt-theme.cms.promoSwitcherTextImageHero.headline') }}</h3>
        <p>{{ element.config.text.value || $t('vierpunkt-theme.cms.promoSwitcherTextImageHero.text') }}</p>
        <div class="sw-cms-el-promo-switcher-text-image-hero__buttons">
            <span>{{ element.config.buttonText.value || $t('vierpunkt-theme.cms.promoSwitcherTextImageHero.buttonText') }}</span>
            <span>{{ element.config.buttonTwoText.value || $t('vierpunkt-theme.cms.promoSwitcherTextImageHero.buttonTwoText') }}</span>
        </div>
    </div>
{% endblock %}
