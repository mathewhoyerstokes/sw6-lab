{% block sw_cms_el_config_promo_image_text_hero %}
    <div class="sw-cms-el-config-promo-image-text-hero">
        <sw-text-field
                v-model:value="element.config.headline.value"
                :label="$t('vierpunkt-theme.cms.promoImageTextHero.headline')"
                @update:value="onElementUpdate"
        />
        <sw-textarea-field
                v-model:value="element.config.text.value"
                :label="$t('vierpunkt-theme.cms.promoImageTextHero.text')"
                @update:value="onElementUpdate"
        />
        <sw-text-field
                v-model:value="element.config.buttonText.value"
                :label="$t('vierpunkt-theme.cms.promoImageTextHero.buttonText')"
                @update:value="onElementUpdate"
        />
        <sw-text-field
                v-model:value="element.config.buttonUrl.value"
                :label="$t('vierpunkt-theme.cms.promoImageTextHero.buttonUrl')"
                @update:value="onElementUpdate"
        />
        <sw-text-field
                v-model:value="element.config.buttonTwoText.value"
                :label="$t('vierpunkt-theme.cms.promoImageTextHero.buttonTwoText')"
                @update:value="onElementUpdate"
        />
        <sw-text-field
                v-model:value="element.config.buttonTwoUrl.value"
                :label="$t('vierpunkt-theme.cms.promoImageTextHero.buttonTwoUrl')"
                @update:value="onElementUpdate"
        />
    </div>
{% endblock %}
